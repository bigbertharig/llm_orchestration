# Rig hardware guard (scripts/rig/hw_guard.py): always-on power, thermal and memory watch that
# gates model loads. Rig-side and independent of the controller; it runs offline too.
# Install: sudo install -m 644 rig-guard.service /etc/systemd/system/ && sudo systemctl enable --now rig-guard
[Unit]
Description=Rig hardware guard (power, thermal, memory; load admission)
# Not After=multi-user.target: rig-plan.service orders itself after the guard and both are wanted by
# multi-user.target, so that was an ordering cycle and systemd dropped rig-plan at boot (2026-10-18).
After=nvidia-persistenced.service rig-power.service

[Service]
Type=simple
User=bryan
Group=bryan
ExecStart=/home/bryan/llm-orchestration-venv/bin/python /home/bryan/llm_orchestration/shared/scripts/rig/hw_guard.py run
Restart=always
RestartSec=5
Nice=-5
# The guard must outlive memory pressure: keep the kernel OOM killer and earlyoom off it.
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
