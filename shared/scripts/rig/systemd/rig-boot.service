# Power-on: leave the rig idle (nothing running) and record GPU health.
# Modes are started on demand with `rig start <mode>` (see ../rig.py).
[Unit]
Description=Rig boot to idle (record state + GPU check)
After=network-online.target remote-fs.target nvidia-persistenced.service
Wants=network-online.target remote-fs.target

[Service]
Type=oneshot
User=bryan
Group=bryan
# /usr/local/bin/rig links to the rig-local checkout, so boot does not wait for network storage.
ExecStart=/usr/local/bin/rig boot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
